@model PortfolioDigital.Web.Models.IndexHomeModel
@using PortfolioDigital.Web.Models.Commun

<section class="about-section text-center" id="about">
    <div class="container px-4 px-lg-5">
        <div class="row gx-3 gx-lg-4 gy-4 justify-content-center">
            <div class="col-lg-10">
                <h2 class="text-white mb-4">@UIText.AboutHeader</h2>
                <p class="text-white-50">@Model.UserModel?.Description</p>
            </div>

            <div class="col-lg-10 mb-15">
                <h2 class="text-white mb-8">@UIText.AboutSubtitle</h2>
                <div class="row gx-4 gy-4 mt-3">
                    @for (int index = 0; index < Model.ProjectModelDisplay?.Count; index++)
                    {
                        <div class="col-12 col-md-4">
                            <div class="card about-card h-100 border-0">
                                <div class="about-card-image-wrapper">
                                    <img class="about-card-image" src="@Url.Content(Model.ProjectModelDisplay[index].ImageUrl)"
                                         alt="@Model.ProjectModelDisplay[index].Title" />
                                </div>
                                <div class="card-body text-start">
                                    <h5 class="card-title mb-2">@Model.ProjectModelDisplay[index].Title</h5>
                                    <p class="card-text mb-0">
                                        @Model.ProjectModelDisplay[index].Description
                                    </p>
                                </div>
                            </div>

                        </div>
                    }
                </div>
            </div>

            <div class="col-10 col-lg-10">
                <img class="img-fluid" src="@Url.Content(Model.UserModel?.ProfileImage)" alt="@UIText.ProfileImageAlt" />
            </div>
        </div>
    </div>
</section>