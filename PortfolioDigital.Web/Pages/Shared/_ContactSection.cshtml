@using PortfolioDigital.Web.Models.Commun
<section class="credit-section bg-black" id="contacts">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5">
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card py-4 h-50">
                    <div class="card-body text-center">
                        <i class="fas fa-map-marked-alt text-primary mb-2" aria-hidden="true"></i>
                        <h4 class="text-uppercase m-0">@UIText.AddressLabel</h4>
                        <img class="social-logo"
                            src="@Url.Content(@Model?.IconsContactPath[0])"
                            alt="Address"
                            width="44"
                            height="38" />
                        <hr class="my-4 mx-auto" />
                        <div class="map">
                            <iframe
                                class="map__iframe"
                                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d84483.97839345546!2d7.679498445287583!3d48.56916757521499!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4796c8495e18b2c1%3A0x971a483118e7241f!2sStrasbourg!5e0!3m2!1sfr!2sfr!4v1784998124008!5m2!1sfr!2sfr"
                                title="Localisation de Strasbourg"
                                loading="lazy"
                                allowfullscreen
                                referrerpolicy="strict-origin-when-cross-origin">
                            </iframe>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card py-4 h-50">
                    <div class="card-body text-center">
                        <i class="fas fa-envelope text-primary mb-2" aria-hidden="true"></i>
                        <h4 class="text-uppercase m-0">@UIText.EmailLabel</h4>
                        <img class="social-logo"
                            src="@Url.Content(@Model?.IconsContactPath[1])"
                            alt="Email"
                            width="44"
                            height="38" />
                        <hr class="my-4 mx-auto" />
                        <div class="small text-black-50">
                            <a href="mailto:@Model?.UserModel?.Email">@Model?.UserModel?.Email</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card py-4 h-50">
                    <div class="card-body text-center">
                        <i class="fas fa-mobile-alt text-primary mb-2" aria-hidden="true"></i>
                        <h4 class="text-uppercase m-0">@UIText.PhoneLabel</h4>
                        <img class="social-logo"
                            src="@Url.Content(@Model?.IconsContactPath[2])"
                            alt="Phone"
                            width="44"
                            height="38" />
                        <hr class="my-4 mx-auto" />
                        <div class="small text-black-50">@Model?.UserModel.PhoneNumber</div>
                    </div>
                </div>
            </div>
        </div>
       
        <div class="social d-flex justify-content-center">
            <a class="mx-2"
                href="@Model?.UserModel?.GitHubUrl"
                background-color="transparent"
                target="_blank"
                aria-label="GitHub">
                <img class="social-logo"
                    src="@Url.Content(@Model?.IconsContactPath[3])"
                    alt="GitHub"
                    width="50"
                    height="50" />
            </a>
        </div>
    </div>
</section>