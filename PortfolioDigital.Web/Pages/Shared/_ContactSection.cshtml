@model PortfolioDigital.Web.Models.IndexHomeModel
@using PortfolioDigital.Web.Models.Commun

<section class="credit-section bg-black" id="contacts">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5">
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card py-4 h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-map-marked-alt text-primary mb-2" aria-hidden="true"></i>
                        <h4 class="text-uppercase m-0">@UIText.AddressLabel</h4>
                        <img class="social-logo" src="@Url.Content(Model.IconsPath?.Find(x => x.Name == "Map").Path)" alt="Map"
                             width="44" height="38" />
                        <hr class="my-4 mx-auto" />
                        <div class="map">
                            <iframe class="map__iframe"
                                    src="@Model.UserModel?.Address" width="100%" height="100%" style="border:0;" allowfullscreen=""
                                    title="Localisation de Strasbourg" loading="lazy" allowfullscreen
                                    referrerpolicy="strict-origin-when-cross-origin">
                            </iframe>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card py-4 h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-envelope text-primary mb-2" aria-hidden="true"></i>
                        <h4 class="text-uppercase m-0">@UIText.EmailLabel</h4>
                        <img class="social-logo" src="@Url.Content(Model.IconsPath?.Find(x => x.Name == "Message").Path)" alt="Email" width="44"
                             height="38" />
                        <hr class="my-4 mx-auto" />
                        <div class="small text-black-50">
                            <a href="mailto:@Model.UserModel?.Email">@Model.UserModel?.Email</a>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card py-4 h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-mobile-alt text-primary mb-2" aria-hidden="true"></i>
                        <h4 class="text-uppercase m-0">@UIText.PhoneLabel</h4>
                        <img class="social-logo" src="@Url.Content(Model.IconsPath?.Find(x => x.Name == "Phone").Path)" alt="Phone" width="44"
                             height="38" />
                        <hr class="my-4 mx-auto" />
                        <div class="small text-black-50">@Model.UserModel?.PhoneNumber</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="social d-flex justify-content-center">
            <a href="@Model.UserModel?.GitHubUrl"
               background-color="transparent" 
               target="_blank"
               aria-label="GitHub">
                <img class="social-logo"
                    src="@Url.Content(Model.IconsPath?.Find(x => x.Name == "GitHub").Path)" 
                    alt="GitHub"
                    width="100"
                    height="100"/>
            </a>
        </div>
    </div>
</section>
