@using PortfolioDigital.Web.Models.Commun
<section class="tarif-Section" id="tarifs">

    <div class="tarif-Section__overlay"></div>
    <div class="nebula nebula--purple"></div>
    <div class="nebula nebula--blue"></div>
    <div class="stack-glow"></div>
    <div class="light-sweep"></div>
    <div class="noise"></div>

    <canvas
      id="particleCanvas"
      aria-hidden="true">
    </canvas>

    <div class="tarif-Section__content">

        <span class="tarif-Section__badge"> @UIText.TarifSloganHeader</span>
        
        <div class="tarif-Section__carousel" aria-label="Carrousel des technologies">
            <div class="tarif-Section__carousel-track">
                <div class="tarif-Section__carousel-set" aria-hidden="true">
                    @for (var i = 0; i < Model.ServiceLogoPathFolder.GetLength(0); i++)
                    {
                        var serviceName = Model.ServiceLogoPathFolder[i,1];
                        var servicePrice = Model.ServiceLogoPathFolder[i,2];

                        <span class="tarif-Section__badge tarif-Section__badge--icon tarif-Section__carousel-item" 
                            data-tech="@serviceName"
                            data-price="@servicePrice">

                            <img class="tarif-Section__logo"
                                 src="@Url.Content(Model.ServiceLogoPathFolder[i,0])"
                                 alt="Logo technologie @(i + 1)" />

                            <div class="carte-prix">
                                <h3>@Model.ServiceLogoPathFolder[i,1]</h3>
                                <div class="prix">
                                    <span class="devise">@UIText.TarifFromHeader</span>
                                </div> 
                                <p class="ancien-prix"><data value="@Model.ServiceLogoPathFolder[i,2]">@Model.ServiceLogoPathFolder[i,2]</data> *</p>
                            </div>
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

</section>
