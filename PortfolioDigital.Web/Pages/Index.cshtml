@page
@using PortfolioDigital.Web.Models.Commun
@model IndexModel

<!--ToChange: Appliquer la régle SOLID sur ces fonctions.-->
@functions {
    private static int ParseLevel(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return 0;
        }

        return int.TryParse(value.Trim().TrimEnd('%'), out var level)
            ? Math.Clamp(level, 0, 100)
            : 0;
    }

    private static string SetLevelBackgroundColor(string? Level)
    {
        string str = Level switch
        {
            "Beginner" => " #67c29c",
            "Intermediate" => " #0d6efd",
            "Advanced" => " #7464a1",
            "Expert" => " #6610f2",
            _ => "rgb(255, 255, 255)"
        };
        return str;
    }
}

@{
    var home = Model.IndexHomeModel;
    var user = home?.UserModel;
    var skills = home?.SkillsModelDisplay?.ToList() ?? new();
    var projects = home?.ProjectModelDisplay?.ToList() ?? new();

    ViewData["Title"] = user?.UserName ?? UIText.DefaultTitle;
    ViewData["SubTitle"] = user?.Profession ?? UIText.DefaultProfession;
}

@await Html.PartialAsync("_Menu", home?.MenuModel)

<!--Master Head-->
<header class="masthead">
    <div class="container px-4 px-lg-5 d-flex h-100 align-items-center justify-content-center">
        <div class="d-flex justify-content-center">
            <div class="text-center">
                <h1 class="mx-auto my-0 text-uppercase">@user?.UserName</h1>
                <h2 class="text-white-50 mx-auto mt-2 mb-5">@user?.Profession</h2>
                <a class="btn btn-primary" href="#about">@UIText.WhoAmIButton</a>
            </div>
        </div>
    </div>
</header>

<!--About-->
<section class="about-section text-center" id="about">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5 justify-content-center">
            <div class="col-lg-8">
                <h2 class="text-white mb-4">@user?.UserName</h2>
                <p class="text-white-50">@user?.Description</p>
            </div>
        </div>
        <img class="img-fluid" 
            src="@UIDataText.ProfileImageAlt" 
            alt="@UIText.ProfileImageAlt" />
    </div>
</section>

<!-- Skills and projects-->
<section class="projects-section bg-light" id="skills">
    <div class="container px-4 px-lg-5">
        <div class="row gx-0 mb-4 mb-lg-5 align-items-center">
            <div class="col-xl-8 col-lg-7">
                @if (skills.Any())
                {
                    <h2 class="text-black mb-4">@UIText.SkillsLanguageHeader</h2>
                    <div class="col-xl-8 col-lg-7">
                        <div class="container"></div>
                        <div class="row">
                            <div class="col-md-6">
                                @foreach (var skill in skills.Where(s => s.Category == "Language"))
                                {
                                    var level = ParseLevel(skill.Level);
                                    var backgroundColor = @SetLevelBackgroundColor(skill.Level);

                                    <h3 class="progressbar-title">@skill.Name</h3>
                                    <div class="progress">
                                        <div class="progress-bar"
                                            role="progressbar"
                                            aria-valuenow="@level"
                                            aria-valuemin="0"
                                            aria-valuemax="100"
                                            style="width:@level%; 
                                            background:@backgroundColor;">
                                            <span class="progress-value">@level%</span>
                                            <span class="progress-icon"
                                                style="border-bottom-color:
                                                @backgroundColor;">
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="col-md-6">
                                @foreach (var skill in skills.Where(s => s.Category == "Framework"))
                                {
                                    var level = ParseLevel(skill.Level);
                                    var backgroundColor = @SetLevelBackgroundColor(skill.Level);

                                    <h3 class="progressbar-title">@skill.Name</h3>
                                    <div class="progress">
                                        <div class="progress-bar"
                                            role="progressbar"
                                            aria-valuenow="@level"
                                            aria-valuemin="0"
                                            aria-valuemax="100"
                                            style="width:@level%; 
                                            background:@backgroundColor;">
                                            <span class="progress-value">@level</span>
                                            <span class="progress-icon" style="border-bottom-color:@backgroundColor;"></span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <h2 class="text-black mb-4">@UIText.SkillsWorkflowHeader</h2>
                    <div class="col-xl-8 col-lg-7">
                        <div class="container"></div>
                        <div class="row">
                            <div class="col-md-6">
                                @foreach (var skill in skills.Where(s => s.Category == "Design"))
                                {
                                    var level = ParseLevel(skill.Level);
                                    var backgroundColor = @SetLevelBackgroundColor(skill.Level);
                                    
                                    <h3 class="progressbar-title">@skill.Name</h3>
                                    <div class="progress">
                                        <div class="progress-bar"
                                            role="progressbar"
                                            aria-valuenow="@level"
                                            aria-valuemin="0"
                                            aria-valuemax="100"
                                            style="width:@level%; 
                                            background:@backgroundColor;">
                                            <span class="progress-value">@level</span>
                                            <span class="progress-icon" style="border-bottom-color:@backgroundColor;"></span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="col-xl-4 col-lg-5">
                <div class="featured-text text-center text-lg-left">
                    <h2 class="text-black mb-4">@UIText.CVHeader</h2>
                    <a href="#!">
                        <img class="img-fluid" 
                            src="@UIDataText.CVImageAlt" 
                            alt="@UIText.CVImageAlt" 
                            <!--ToChange: Configurer l'affichage en plein écran.-->
                            width="300" 
                            height="300"/>
                        @UIText.DownloadLabel
                    </a>
                </div>
            </div>
        </div>

        <h2 class="text-black mb-4" id="projects">@UIText.ExperiencesHeader</h2>

        @if (projects.Any()) 
        {
            @for (var index = 0; index < projects.Count(); index++) 
            {
                var project = projects[index];
                var imageFirst = index % 2 == 1;

                <div class="row gx-0 @(imageFirst ? "mb-5 mb-lg-0" : string.Empty) justify-content-center">
                    <div class="col-lg-6">
                        <img class="img-fluid"
                            src="@project.ImageUrl"
                            alt="@UIText.ProjectImageAlt" />
                    </div>
                    <div class="col-lg-6 @(imageFirst ? string.Empty : "order-lg-1")">
                        <div class="bg-black text-center h-100 project">
                            <div class="d-flex h-100">
                                <div class="project-text w-100 my-auto text-center @(imageFirst ? "text-lg-left" : "text-lg-right")">
                                    <h4 class="text-white">@project.Title</h4>
                                    <p class="mb-0 text-white-50">@project.Description</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</section>

<!-- Credit-->
<section class="signup-section" id="privacy">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5">
            <div class="col-md-10 col-lg-8 mx-auto text-center">
                <h2 class="text-white mb-4">@UIText.ProjectsTitle</h2>
                <p class="text-white-50">
                    @UIText.ProjectsDescription
                    <a href="@UIText.LinkGrayscale" 
                        target="_blank" 
                        rel="noopener noreferrer">Start Bootstrap</a>
                </p>
            </div>
         </div>
    </div>
</section>

<!-- Contact-->
<section class="contact-section bg-black" id="contacts">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5">
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card py-4 h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-map-marked-alt text-primary mb-2" aria-hidden="true"></i>
                        <h4 class="text-uppercase m-0">@UIText.AddressLabel</h4>
                        <hr class="my-4 mx-auto" />
                        <div class="small text-black-50">@user?.Address</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card py-4 h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-envelope text-primary mb-2" aria-hidden="true"></i>
                        <h4 class="text-uppercase m-0">@UIText.EmailLabel</h4>
                        <hr class="my-4 mx-auto" />
                        <div class="small text-black-50">
                           @if (!string.IsNullOrWhiteSpace(user?.Email))
                            {
                                <a href="mailto:@user.Email">@user.Email</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card py-4 h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-mobile-alt text-primary mb-2" aria-hidden="true"></i>
                        <h4 class="text-uppercase m-0">@UIText.PhoneLabel</h4>
                        <hr class="my-4 mx-auto" />
                        <div class="small text-black-50">@user?.PhoneNumber</div>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(user?.GitHubUrl))
        {
            <div class="social d-flex justify-content-center">
                <a class="mx-2"
                   href="@user.GitHubUrl"
                   target="_blank"
                   aria-label="GitHub">
                    <i class="fab fa-github" aria-hidden="true"></i>
                </a>
            </div>
        }
    </div>
</section>

@section Scripts 
{
    <script src="~/js/site.js"></script>
}