@page
@using PortfolioDigital.Web.Models.Commun
@model IndexModel

@{
    var home = Model.IndexHomeModel;
    var user = home?.UserModel;
    var skills = home?.SkillsModelDisplay?.ToList() ?? new();
    var projects = home?.ProjectModelDisplay?.ToList() ?? new();

    ViewData["Title"] = user?.UserName ?? UIText.DefaultTitle;
    ViewData["SubTitle"] = user?.Profession ?? UIText.DefaultProfession;
}

@await Html.PartialAsync("_Menu", home?.MenuModel)

<!--Master Head-->
<header class="masthead supernova-hero">
    <div class="container px-4 px-lg-5 d-flex h-100 align-items-center justify-content-center">
        <div class="d-flex justify-content-center">
            <div class="text-center supernova-content">
                <h1 class="mx-auto my-0 text-uppercase supernova-title">@user?.UserName</h1>
                <h2 class="text-white-50 mx-auto mt-2 mb-5 supernova-subtitle">@user?.Profession</h2>
                <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                    <a class="btn btn-primary" href="#about">@UIText.WhoAmIButton</a>
                    <button type="button"
                            class="btn btn-outline-light"
                            data-bs-toggle="modal"
                            data-bs-target="#introModal">
                        Ouvrir une pop-up
                    </button>
                </div>
            </div>
        </div>
    </div>

</header>

<div class="modal fade" id="introModal" tabindex="-1" aria-labelledby="introModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="introModalLabel">Exemple de pop-up Bootstrap</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">
                    Cette fenetre est ouverte directement depuis un bouton Razor avec
                    <code>data-bs-toggle="modal"</code> et <code>data-bs-target="#introModal"</code>.
                </p>
                <p class="mb-0 text-muted">
                    Tu peux reutiliser ce modele pour afficher un message, une confirmation ou des details dynamiques.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

<!--About-->
<section class="about-section text-center" id="about">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5 justify-content-center">
            <div class="col-lg-8">
                <h2 class="text-white mb-4">@user?.UserName</h2>
                <p class="text-white-50">@user?.Description</p>
            </div>
        </div>
        <img class="img-fluid" 
            src="@UIDataText.ProfileImageAlt" 
            alt="@UIText.ProfileImageAlt" />
    </div>
</section>

<!-- Skills and projects-->
<section class="projects-section bg-light section-Custom" id="skills">
    <div class="container px-4 px-lg-5">
        <div class="row gx-0 mb-4 mb-lg-5 align-items-center">
            <div class="col-xl-8 col-lg-7">
                @if (skills.Any())
                {
                    <h2 class="text-black mb-4">@UIText.SkillsLanguageHeader</h2>
                    <div class="col-xl-8 col-lg-7">
                        <div class="container"></div>
                        <div class="row">
                            <div class="col-md-6">
                                @await Html.PartialAsync("_ProgressbarSkills", skills.Where(s => s.Category == "Language"))
                            </div>
                            <div class="col-md-6">
                                @await Html.PartialAsync("_ProgressbarSkills", skills.Where(s => s.Category == "Framework"))
                            </div>
                        </div>
                    </div>
                    <h2 class="text-black mb-4">@UIText.SkillsWorkflowHeader</h2>
                    <div class="col-xl-8 col-lg-7">
                        <div class="container"></div>
                        <div class="row">
                            <div class="col-md-6">
                                @await Html.PartialAsync("_ProgressbarSkills", skills.Where(s => s.Category == "Design" || s.Category == "Version Control"))
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="col-xl-4 col-lg-5">
                <div class="featured-text text-center text-lg-left">
                    <h2 class="text-black mb-4">@UIText.CVHeader</h2>
                    <a href="#!">
                        <img class="img-fluid" 
                            src="@UIDataText.CVImageAlt" 
                            alt="@UIText.CVImageAlt" 
                            width="300" 
                            height="300"/>
                        @UIText.DownloadLabel
                    </a>
                </div>
            </div>
        </div>

        <h2 class="text-black mb-4" id="projects">@UIText.ExperiencesHeader</h2>

        @if (projects.Any()) 
        {
            @await Html.PartialAsync("_CardProjects", projects)
        }
    </div>
    
</section>

@await Html.PartialAsync("_Modal")

<!-- Credit-->
<section class="signup-section" id="privacy">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5">
            <div class="col-md-10 col-lg-8 mx-auto text-center">
                <h2 class="text-white mb-4">@UIText.ProjectsTitle</h2>
                <p class="text-white-50">
                    @UIText.ProjectsDescription
                    <a href="@UIText.LinkGrayscale" 
                        target="_blank" 
                        rel="noopener noreferrer">Start Bootstrap</a>
                </p>
            </div>
         </div>
    </div>
</section>

<!-- Contact-->
<section class="contact-section bg-black" id="contacts">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5">
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card py-4 h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-map-marked-alt text-primary mb-2" aria-hidden="true"></i>
                        <h4 class="text-uppercase m-0">@UIText.AddressLabel</h4>
                        <hr class="my-4 mx-auto" />
                        <div class="small text-black-50">@user?.Address</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card py-4 h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-envelope text-primary mb-2" aria-hidden="true"></i>
                        <h4 class="text-uppercase m-0">@UIText.EmailLabel</h4>
                        <hr class="my-4 mx-auto" />
                        <div class="small text-black-50">
                           @if (!string.IsNullOrWhiteSpace(user?.Email))
                            {
                                <a href="mailto:@user?.Email">@user?.Email</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card py-4 h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-mobile-alt text-primary mb-2" aria-hidden="true"></i>
                        <h4 class="text-uppercase m-0">@UIText.PhoneLabel</h4>
                        <hr class="my-4 mx-auto" />
                        <div class="small text-black-50">@user?.PhoneNumber</div>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(user?.GitHubUrl))
        {
            <div class="social d-flex justify-content-center">
                <a class="mx-2"
                   href="@user.GitHubUrl"
                   target="_blank"
                   aria-label="GitHub">
                    <img class="social-logo"
                        src="~/assets/img/github-logo.png"
                        alt="GitHub"
                        width="22"
                        height="22" />
                </a>
            </div>
        }
    </div>
</section>

