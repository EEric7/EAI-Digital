@page
@using PortfolioDigital.Web.Models.Commun
@model IndexModel

@{
    Models.IndexHomeModel? home = Model.IndexHomeModel;
}

@await Html.PartialAsync("_IndexNav", home)

<!--Master Head-->
<header class="masthead">
    <div class="container px-4 px-lg-5 d-flex h-100 align-items-center justify-content-center">
        <div class="d-flex justify-content-center">
            <div class="text-center">
                <h1 class="mx-auto my-0 text-uppercase">@home?.UserModel?.UserName</h1>
                <h2 class="text-white-50 mx-auto mt-2 mb-5">@home?.UserModel?.Profession</h2>
                <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                    <a class="btn btn-primary" href="#about">@UIText.WhoAmIButton</a>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- Services-->
@await Html.PartialAsync("_ServiceSection", home)

<!-- Tarifs-->
@await Html.PartialAsync("_TarifSection", home)

<!--About-->
@await Html.PartialAsync("_AboutSection", home)

<!-- Contact-->
@await Html.PartialAsync("_ContactSection", home)

<footer class="bg-dark font-f footer text-muted align-items-center justify-content-center">
    <div class="container px-4 px-lg-5 d-flex h-100 align-items-center justify-content-center">
        &copy; 2026 - <a>@home?.UserModel?.Enseigne</a>
    </div>
</footer>

